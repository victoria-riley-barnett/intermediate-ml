---
// Development-only: every atom on one sheet, with the exact tag to copy.
// Nothing is emitted for this route in a production build.
import Book from '../../layouts/Book.astro';
import { ATOMS_SLUG, atoms, type AtomData } from '../../lib/atoms';

export async function getStaticPaths() {
  if (!import.meta.env.DEV) return [];
  return [{ params: { slug: ATOMS_SLUG }, props: { sheet: atoms } }];
}
interface Props { sheet: AtomData[] }
const { sheet } = Astro.props;
---
<Book title="Atoms" noindex>
  <p class="eyebrow">Draft sheet</p>
  <h1>Atoms</h1>
  <p>{sheet.length} fragments in <code>src/atoms</code>, generated by <code>teaching/411/admin/diagrams/tools/emit_atoms.py</code>. Fix the plate or its tool and regenerate; never edit a fragment here. Names starting <code>plate-</code> are whole 1280px plates kept only as placeholders until their steps are redrawn as atoms.</p>
  <ul class="atom-sheet">
    {sheet.map((a) => (
      <li class="atom-card">
        <div class="atom"><Fragment set:html={a.html} /></div>
        <p class="atom-meta">src/atoms/{a.name}.html</p>
        <p class="atom-meta">&lt;Atom name="{a.name}" /&gt;</p>
      </li>
    ))}
  </ul>
</Book>
